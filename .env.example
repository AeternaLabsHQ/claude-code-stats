# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. Only the calibration script (tools/calibrate_write_categories.py)
# currently reads from here.

# Anthropic API key, used by --backend anthropic in the calibration script.
# Get one at https://console.anthropic.com/. The count_tokens endpoint used
# by the script is free of charge but subject to per-tier RPM limits.
ANTHROPIC_API_KEY=
