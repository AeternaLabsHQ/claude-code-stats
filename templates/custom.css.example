/* ============================================================
   claude-stats - custom.css
   ============================================================
   This file lets you override the dashboard's color scheme
   without touching the source CSS. Copy this file to
   `public/custom.css` and uncomment / change the values
   you want to customize.

       cp public/custom.css.example public/custom.css

   On each rebuild, `extract_stats.py` creates an empty
   `public/custom.css` only if one does not already exist,
   so your edits survive subsequent builds. The deployed
   dashboard loads `custom.css` AFTER the inlined `<style>`
   block, so anything here wins the cascade.

   IMPORTANT: target the theme-scoped selectors (html.theme-light
   .vc / html.theme-dark .vc), not just `.vc`, otherwise the
   built-in theme rules win on specificity.

   Two CSS variable namespaces exist:
   - `--vc-*`   : design tokens (header, panels, primary surfaces,
                  KPI tiles, footer, controls)
   - legacy `--bg`, `--accent`, etc. : used by Chart.js charts
                  and innerHTML-rendered sections
   For a complete recolor you usually want to set both.

   ACCENT NOTE: charts and the activity heatmap read the LIVE
   `--vc-accent` value, so overriding just `--vc-accent` (+ the
   legacy `--accent`) recolors the accent-driven charts too - no
   rebuild needed. The heatmap (cells + legend) additionally uses
   `--vc-accent-rgb` (the same color as a bare `R,G,B` triple for
   rgba() composition), so set it alongside `--vc-accent` when you
   change the accent. See the accent presets at the bottom.
   ============================================================ */


/* ---------- LIGHT THEME (current defaults, for reference) ---------- */

/*
html.theme-light .vc {
  --vc-bg:           #f5f6f8;
  --vc-panel:        #ffffff;
  --vc-grid:         #e7e9ee;
  --vc-grid-2:       #e7e9ee;
  --vc-fg:           #14161c;
  --vc-fg-2:         #5b6473;
  --vc-fg-3:         #99a1af;
  --vc-accent:       #c2562f;
  --vc-accent-rgb:   194,86,47;
  --vc-accent-soft:  rgba(194,86,47,.10);
}
html.theme-light body.vc-page {
  --bg:      #f5f6f8;
  --bg2:     #ffffff;
  --bg3:     #eef0f3;
  --border:  #e7e9ee;
  --text:    #14161c;
  --text2:   #5b6473;
  --accent:  #c2562f;
  --accent2: #cf6b45;
  --green:   #1f9d63;
  --orange:  #c2562f;
  --red:     #d24b3e;
  --blue:    #5b6473;
  --purple:  #5b6473;
  --cyan:    #5b6473;
  --amber:   #c2562f;
}
*/


/* ---------- DARK THEME (current defaults, for reference) ---------- */

/*
html.theme-dark .vc {
  --vc-bg:           #0e1014;
  --vc-panel:        #181b21;
  --vc-grid:         #262b33;
  --vc-grid-2:       #262b33;
  --vc-fg:           #eef0f4;
  --vc-fg-2:         #a8afbb;
  --vc-fg-3:         #6b7380;
  --vc-accent:       #e27a51;
  --vc-accent-rgb:   226,122,81;
  --vc-accent-soft:  rgba(226,122,81,.16);
}
html.theme-dark body.vc-page {
  --bg:      #0e1014;
  --bg2:     #181b21;
  --bg3:     #1f242c;
  --border:  #262b33;
  --text:    #eef0f4;
  --text2:   #a8afbb;
  --accent:  #e27a51;
  --accent2: #ec8b6a;
  --green:   #34c77f;
  --orange:  #e27a51;
  --red:     #f0786b;
  --blue:    #a8afbb;
  --purple:  #a8afbb;
  --cyan:    #a8afbb;
  --amber:   #e27a51;
}
*/


/* ---------- SYSTEM PREFERENCE (when no explicit theme is set) ---------- */

/*
@media (prefers-color-scheme: dark) {
  html:not(.theme-light) .vc {
    --vc-accent:      #e27a51;
    --vc-accent-rgb:  226,122,81;
    --vc-accent-soft: rgba(226,122,81,.16);
  }
  html:not(.theme-light) body.vc-page {
    --accent: #e27a51;
  }
}
*/


/* ============================================================
   ACCENT PRESETS
   The default accent is terracotta. To switch the whole UI
   (nav, KPIs, links, charts, heatmap) to a different accent,
   uncomment ONE of the blocks below. Each recolors light +
   dark in one go and sets the --vc-accent token, its
   --vc-accent-rgb triple (heatmap cells + legend) and the
   legacy --accent so charts follow along.
   ============================================================ */

/* === Accent: Indigo === */
/*
html.theme-light .vc, html.theme-light body.vc-page { --vc-accent:#4f46e5; --vc-accent-rgb:79,70,229; --vc-accent-soft:rgba(79,70,229,.10); --accent:#4f46e5; }
html.theme-dark  .vc, html.theme-dark  body.vc-page { --vc-accent:#818cf8; --vc-accent-rgb:129,140,248; --vc-accent-soft:rgba(129,140,248,.18); --accent:#818cf8; }
*/

/* === Accent: Emerald === */
/*
html.theme-light .vc, html.theme-light body.vc-page { --vc-accent:#0e9f6e; --vc-accent-rgb:14,159,110; --vc-accent-soft:rgba(14,159,110,.10); --accent:#0e9f6e; }
html.theme-dark  .vc, html.theme-dark  body.vc-page { --vc-accent:#34d399; --vc-accent-rgb:52,211,153; --vc-accent-soft:rgba(52,211,153,.18); --accent:#34d399; }
*/

/* === Classic Indigo === */
/* The color scheme used up to 0.8.x. Backgrounds are near identical
   between the two designs, so restoring the accent restores the look. */
/*
html.theme-light .vc, html.theme-light body.vc-page { --vc-accent:#6366f1; --vc-accent-rgb:99,102,241; --vc-accent-soft:rgba(99,102,241,.10); --accent:#6366f1; }
html.theme-dark  .vc, html.theme-dark  body.vc-page { --vc-accent:#818cf8; --vc-accent-rgb:129,140,248; --vc-accent-soft:rgba(129,140,248,.18); --accent:#818cf8; }
*/
