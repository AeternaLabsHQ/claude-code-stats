}
*/


/* ---------- CHART PALETTE TOKENS (defaults, for reference) ----------
   All chart colors are tokens too, read live by the charts, so you can
   ship your own palette here (no rebuild needed). Values below are the
   light-theme defaults; set the html.theme-dark .vc variants alongside.
   With config.json "palette": "colorblind" the page carries
   html.palette-cvd, so target html.palette-cvd.theme-light .vc etc.
   Categorical slots (fixed order, used by doughnuts and multi-series bars): */
/*
html.theme-light .vc {
  --vc-cat-1: #c2562f; --vc-cat-2: #556dc6; --vc-cat-3: #5c8311; --vc-cat-4: #8a2b60;
  --vc-cat-5: #039256; --vc-cat-6: #9258ad; --vc-cat-7: #c68206; --vc-cat-8: #1479c1;
  --vc-cat-n1: #62573e; --vc-cat-n2: #89939e;
  --vc-model-opus-1: #c2562f; --vc-model-opus-2: #d26f4d; --vc-model-opus-3: #e18869; --vc-model-opus-4: #f1a085;
  --vc-model-sonnet-1: #0a8d83; --vc-model-sonnet-2: #3f9e94; --vc-model-sonnet-3: #5fafa6; --vc-model-sonnet-4: #7dc1b8;
  --vc-model-haiku-1: #635e01; --vc-model-haiku-2: #7c7934; --vc-model-haiku-3: #969458; --vc-model-haiku-4: #b2b07c;
  --vc-model-fable-1: #9a4c95; --vc-model-fable-2: #ad66a8; --vc-model-fable-3: #c07fba; --vc-model-fable-4: #d399cd;
  --vc-model-unknown: #4e5966;
  --vc-series-1: #4d4a42; --vc-series-2: #788b98; --vc-series-soft: #f1d9cd;
  --vc-pos: #0c5805; --vc-pos-soft: rgba(12,88,5,.10); --vc-neg: #83054a; --vc-neg-soft: rgba(131,5,74,.10);
}
*/


/* ---------- SYSTEM PREFERENCE (when no explicit theme is set) ---------- */

/*
@media (prefers-color-scheme: dark) {
  html:not(.theme-light) .vc {
    --vc-accent:      #e27a51;
    --vc-accent-rgb:  226,122,81;
    --vc-accent-soft: rgba(226,122,81,.16);
  }
  html:not(.theme-light) body.vc-page {
    --accent: #e27a51;
  }
}
*/


/* ============================================================
   ACCENT PRESETS
   The default accent is terracotta. To switch the whole UI
   (nav, KPIs, links, charts, heatmap) to a different accent,
   uncomment ONE of the blocks below. Each recolors light +
   dark in one go and sets the --vc-accent token, its
   --vc-accent-rgb triple (heatmap cells + legend) and the
   legacy --accent so charts follow along.
   ============================================================ */

/* === Accent: Indigo === */
/*
html.theme-light .vc, html.theme-light body.vc-page { --vc-accent:#4f46e5; --vc-accent-rgb:79,70,229; --vc-accent-soft:rgba(79,70,229,.10); --accent:#4f46e5; }
html.theme-dark  .vc, html.theme-dark  body.vc-page { --vc-accent:#818cf8; --vc-accent-rgb:129,140,248; --vc-accent-soft:rgba(129,140,248,.18); --accent:#818cf8; }
*/

/* === Accent: Emerald === */
/*
html.theme-light .vc, html.theme-light body.vc-page { --vc-accent:#0e9f6e; --vc-accent-rgb:14,159,110; --vc-accent-soft:rgba(14,159,110,.10); --accent:#0e9f6e; }
html.theme-dark  .vc, html.theme-dark  body.vc-page { --vc-accent:#34d399; --vc-accent-rgb:52,211,153; --vc-accent-soft:rgba(52,211,153,.18); --accent:#34d399; }
*/

/* === Classic Indigo === */
/* The color scheme used up to 0.8.x. Backgrounds are near identical
   between the two designs, so restoring the accent restores the look. */
/*
html.theme-light .vc, html.theme-light body.vc-page { --vc-accent:#6366f1; --vc-accent-rgb:99,102,241; --vc-accent-soft:rgba(99,102,241,.10); --accent:#6366f1; }
html.theme-dark  .vc, html.theme-dark  body.vc-page { --vc-accent:#818cf8; --vc-accent-rgb:129,140,248; --vc-accent-soft:rgba(129,140,248,.18); --accent:#818cf8; }
*/
